{
  "name": "bills",
  "onlyBuiltDependencies": [
    "esbuild"
  ],
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "docker compose --profile tools run --rm dbmate up",
    "db:rollback": "docker compose --profile tools run --rm dbmate rollback",
    "db:status": "docker compose --profile tools run --rm dbmate status",
    "db:new": "docker compose --profile tools run --rm dbmate new"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.12.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "fastify": "^5.11.0",
    "zod": "^4.4.3"
  }
}
