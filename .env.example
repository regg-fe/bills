# Database (PostgreSQL & PgBouncer)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bills_db
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

# Application (Connection Strings)
DATABASE_URL=postgres://postgres:postgres@localhost:6432/bills_db
REDIS_URL=redis://localhost:6379

# Redis
REDIS_PORT=6379

# MinIO (S3 Local)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailpit (SMTP Test Server)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Auth JWT
JWT_SECRET=genera-uno-aleatorio-de-32+-chars
JWT_REFRESH_SECRET=cambiar-por-secreto-real-minimo-32-chars

# S3 (Tigris/R2)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bills-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Email -> Opcional
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# MVP -> Opcional
VAULT_ADDR=
NODE_ENV=development
PORT=3000

# Observabilidad
SENTRY_DSN=
LOG_LEVEL=info
